#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Create system user if it doesn't exist
    if ! getent passwd statsite >/dev/null 2>&1 ; then
        adduser --quiet \
                --system \
                --group \
                --no-create-home \
                --home /nonexistent \
                --shell /usr/sbin/nologin \
                --gecos "Statsite metrics daemon" \
                statsite
    fi

    # Create required directories
    install -d -m 755 -o statsite -g statsite /var/log/statsite
    install -d -m 755 -o statsite -g statsite /var/run/statsite

    # Ensure configuration files are readable by the dedicated statsite user
    if [ -d /etc/statsite ]; then
        chown -R root:statsite /etc/statsite
        find /etc/statsite -type f -exec chmod 640 {} \;
        find /etc/statsite -type d -exec chmod 750 {} \;
    fi
fi

#DEBHELPER#

exit 0